<Window x:Class="Songyu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="凇语 MCloader" Height="680" Width="1000"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource EggWhite}"
        Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource AppFont}"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
            Background="{StaticResource EggWhite}">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="#F7F0DC" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image Source="Assets/app.ico" Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="凇语 MCloader" Margin="9,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"/>
                    <Button Content="✕" Style="{StaticResource CaptionButton}" Click="OnCloseClick"/>
                </StackPanel>
            </Grid>

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                </Grid.ColumnDefinitions>

                <!-- 内容 -->
                <Grid Grid.Column="0">
                    <ContentControl x:Name="ContentHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"/>
                </Grid>

                <!-- 右侧导航：垂直居中，图标 + 文字 -->
                <Border Grid.Column="1" Background="{StaticResource NavBg}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="HomeNav" Tag="0" Style="{StaticResource NavButton}" Click="OnNavClick">
                            <StackPanel>
                                <TextBlock Text="⌂" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="启动" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DownloadNav" Tag="1" Style="{StaticResource NavButton}" Click="OnNavClick">
                            <StackPanel>
                                <TextBlock Text="↓" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="下载" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ModsNav" Tag="2" Style="{StaticResource NavButton}" Click="OnNavClick">
                            <StackPanel>
                                <TextBlock Text="▤" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="Mod" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>                        <Button x:Name="SkinNav" Tag="6" Style="{StaticResource NavButton}" Click="OnNavClick">
                            <StackPanel>
                                <TextBlock Text="☺" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="皮肤" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>                        <Button x:Name="ServersNav" Tag="5" Style="{StaticResource NavButton}" Click="OnNavClick">
                            <StackPanel>
                                <TextBlock Text="⇄" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="联机" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShotsNav" Tag="4" Style="{StaticResource NavButton}" Click="OnNavClick">
                            <StackPanel>
                                <TextBlock Text="▣" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="截图" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsNav" Tag="3" Style="{StaticResource NavButton}" Click="OnNavClick">
                            <StackPanel>
                                <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="设置" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 应用内弹窗层 -->
            <Grid x:Name="DialogLayer" Grid.RowSpan="2" Background="{StaticResource Scrim}"
                  Visibility="Collapsed" MouseLeftButtonDown="OnDialogLayerMouseDown">

                <Border Width="470" Background="{StaticResource CardBg}" CornerRadius="16"
                        Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="DialogScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.2" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock x:Name="DialogTitle" FontSize="17" FontWeight="SemiBold"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="DialogMessage" TextWrapping="Wrap"
                                       FontSize="13" LineHeight="21"
                                       Foreground="{StaticResource InkSoft}"/>

                            <!-- 只在内容含地址/路径/错误码这类需要转发的信息时出现 -->
                            <Button x:Name="DialogCopyButton" Grid.Column="1"
                                    Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                    Style="{StaticResource CaptionButton}"
                                    Width="26" Height="26" Margin="10,-3,0,0"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    ToolTip="复制这段内容"
                                    Click="OnDialogCopyClick"/>
                        </Grid>

                        <!-- 需要用户输入一行文字时才显示（新建 / 重命名实例） -->
                        <TextBox x:Name="DialogInput" Margin="0,14,0,0" Visibility="Collapsed"
                                 KeyDown="OnDialogInputKeyDown"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <Button x:Name="DialogSecondary" Content="取消" Style="{StaticResource GhostButton}"
                                    Height="38" MinWidth="96" Margin="0,0,8,0" Visibility="Collapsed"
                                    Click="OnDialogSecondaryClick"/>
                            <Button x:Name="DialogPrimary" Content="知道了" Style="{StaticResource PrimaryButton}"
                                    Height="38" MinWidth="104" Click="OnDialogPrimaryClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 登录专用弹窗：地址和代码各自带复制按钮，不让人从整段文字里挑 -->
            <Grid x:Name="LoginDialogLayer" Grid.RowSpan="2" Background="{StaticResource Scrim}"
                  Visibility="Collapsed" MouseLeftButtonDown="OnDialogLayerMouseDown">
                <Border Background="{StaticResource CardBg}" CornerRadius="14" Padding="26,22"
                        MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.2" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="登录微软账号" FontSize="17" FontWeight="SemiBold"/>

                        <TextBlock Text="1. 在浏览器里打开这个地址" FontSize="11" Margin="0,18,0,0"
                                   Foreground="{StaticResource InkSoft}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LoginDialogUrl" FontSize="13" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{StaticResource Ink}"/>
                            <Button x:Name="LoginCopyUrlButton" Grid.Column="1" Content="&#xE8C8;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="13"
                                    Style="{StaticResource CaptionButton}" Width="26" Height="26"
                                    Margin="10,0,0,0" ToolTip="复制地址"
                                    Click="OnCopyLoginUrlClick"/>
                        </Grid>

                        <TextBlock Text="2. 输入这个代码" FontSize="11" Margin="0,18,0,0"
                                   Foreground="{StaticResource InkSoft}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LoginDialogCode" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{StaticResource Ink}"/>
                            <Button x:Name="LoginCopyCodeButton" Grid.Column="1" Content="&#xE8C8;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="13"
                                    Style="{StaticResource CaptionButton}" Width="26" Height="26"
                                    Margin="10,0,0,0" ToolTip="复制验证码"
                                    Click="OnCopyLoginCodeClick"/>
                        </Grid>

                        <TextBlock Text="3. 登录并点「允许」，这边会自动继续" FontSize="11" Margin="0,18,0,0"
                                   Foreground="{StaticResource InkSoft}"/>

                        <Button Content="知道了" Style="{StaticResource PrimaryButton}"
                                Height="38" MinWidth="104" HorizontalAlignment="Right" Margin="0,24,0,0"
                                Click="OnCloseLoginDialogClick"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 下载浮窗：平常不出现，有任务时浮现，可折叠 -->
            <Border x:Name="DownloadCard" Grid.RowSpan="2" Visibility="Collapsed"
                    Width="330" Margin="0,0,26,26"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="12" Padding="16,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.16" Color="#000000"/>
                </Border.Effect>

                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DownloadCardTitle" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DownloadPercentText" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CollapseButton" Content="⌄" Style="{StaticResource CaptionButton}"
                                    Width="30" Height="30" FontSize="14" Click="OnCollapseDownloadClick"/>
                            <Button Content="✕" Style="{StaticResource CaptionButton}"
                                    Width="30" Height="30" FontSize="11" Click="OnCancelClick"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="DownloadCardBody" Margin="0,10,0,0">
                        <TextBlock x:Name="DownloadFileText" FontSize="11"
                                   Foreground="{StaticResource InkSoft}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="DownloadBar" Height="5" Minimum="0" Maximum="1" Margin="0,8,0,0"
                                     Background="{StaticResource Line}"
                                     Foreground="{StaticResource EggYolk}"
                                     BorderThickness="0"/>
                        <TextBlock x:Name="DownloadSpeedText" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource InkSoft}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 操作提示：浮在内容上方，不占布局，几秒后自动消失 -->
            <Border x:Name="ToastHost" Grid.RowSpan="2" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="0,0,96,26" Opacity="0"
                    IsHitTestVisible="False" Background="#F2F7F1DF"
                    BorderBrush="{StaticResource EggYolk}" BorderThickness="1"
                    CornerRadius="10" Padding="16,9">
                <TextBlock x:Name="ToastText" FontSize="12" Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" MaxWidth="560"/>
            </Border>

            <!-- 拖放提示遮罩：文件拖到窗口上时盖住整个界面 -->
            <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                    Margin="10" CornerRadius="12" IsHitTestVisible="False"
                    Background="#F5FAF7EF" BorderBrush="{StaticResource EggYolk}" BorderThickness="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="DropTitleText" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="DropHintText" FontSize="13" Margin="0,10,0,0"
                               HorizontalAlignment="Center" Foreground="{StaticResource InkSoft}"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
