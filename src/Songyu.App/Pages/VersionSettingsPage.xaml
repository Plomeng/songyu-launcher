<UserControl x:Class="Songyu.App.Pages.VersionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="26,4,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="←" Style="{StaticResource GhostButton}" Width="40" Padding="0"
                    Click="OnBackClick"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtitleText" FontSize="11"
                           Foreground="{StaticResource InkSoft}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>

                <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="内存" FontSize="13" FontWeight="SemiBold"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="最大内存 (MB)" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource InkSoft}"/>
                            <TextBox x:Name="MaxMemoryBox" Grid.Column="1" Text="2048"/>
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource InkSoft}" Text="建议 2048–4096"/>

                            <TextBlock Grid.Row="1" Text="最小内存 (MB)" FontSize="12" Margin="0,8,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource InkSoft}"/>
                            <TextBox x:Name="MinMemoryBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,8,0,0" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource InkSoft}"
                                       Text="0 表示由 JVM 自行决定"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Java" FontSize="13" FontWeight="SemiBold"/>
                        <ComboBox x:Name="JavaCombo" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="游戏窗口" FontSize="13" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="宽" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource InkSoft}"/>
                            <TextBox x:Name="WidthBox" Width="90" Margin="8,0,0,0" Text="1280"/>
                            <TextBlock Text="高" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{StaticResource InkSoft}"/>
                            <TextBox x:Name="HeightBox" Width="90" Margin="8,0,0,0" Text="720"/>
                            <CheckBox x:Name="FullscreenBox" Content="全屏启动" Margin="20,0,0,0"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="额外 JVM 参数" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox x:Name="JvmArgsBox" Margin="0,12,0,0" Height="60"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="10,8"/>
                        <TextBlock Margin="2,8,0,0" FontSize="11" Foreground="{StaticResource InkSoft}"
                                   Text="空格分隔，例如 -XX:+UseG1GC -XX:MaxGCPauseMillis=50"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="删除这个版本的文件" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    ToolTip="只删 versions 下的版本目录，实例目录（存档/Mod/设置）不动"
                    Click="OnDeleteClick"/>
            <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}"
                    Height="40" MinWidth="120" HorizontalAlignment="Right" Click="OnSaveClick"/>
        </Grid>
    </Grid>
</UserControl>
