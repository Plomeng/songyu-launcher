<UserControl x:Class="Songyu.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,4,10,20">

            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="正版账号" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AccountStatusText" Margin="0,10,0,0" FontSize="12"
                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="LoginButton" Content="登录微软账号" Style="{StaticResource SmallButton}"
                                Height="34" Click="OnLoginClick"/>
                        <Button x:Name="LogoutButton" Content="退出登录" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Visibility="Collapsed" Click="OnLogoutClick"/>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource InkSoft}"
                               TextWrapping="Wrap"
                               Text="游戏启动需要拥有 Minecraft: Java Edition 的微软账号，以及本应用已获批的 Client ID。"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Client ID" FontSize="12" VerticalAlignment="Top" Margin="0,6,0,0"
                                   Foreground="{StaticResource InkSoft}"/>
                        <TextBox x:Name="ClientIdBox" Grid.Column="1" HorizontalAlignment="Left" Width="300"
                                 Height="34" TextWrapping="NoWrap"
                                 VerticalContentAlignment="Center" Padding="8,6" FontFamily="Consolas"/>
                        <Button Grid.Column="2" Content="怎么获取" Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" VerticalAlignment="Top" Click="OnClientIdHelpClick"/>
                    </Grid>

                    <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource InkSoft}"
                               TextWrapping="Wrap"
                               Text="仅填写本应用自己的、已通过 Minecraft 服务审核的单个 Client ID。未获批前保持留空。"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="网络" FontSize="13" FontWeight="SemiBold"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="代理方式" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkSoft}"/>
                        <ComboBox x:Name="ProxyModeCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Text="代理地址" FontSize="12" Margin="0,10,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource InkSoft}"/>
                        <TextBox x:Name="ProxyBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                                 Width="280" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Text="并发下载" FontSize="12" Margin="0,10,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource InkSoft}"/>
                        <TextBox x:Name="ConcurrencyBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                                 Width="90" HorizontalAlignment="Left"/>

                    </Grid>

                    <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource InkSoft}"
                               TextWrapping="Wrap"
                               Text="游戏文件只从官方地址下载。代理地址只在「自定义代理」下生效；并发数建议 8。"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="数据目录" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DataPathText" Margin="0,8,0,0" FontSize="12"
                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="打开数据目录" Style="{StaticResource GhostButton}" Click="OnOpenDataClick"/>
                        <Button Content="打开配置文件" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnOpenConfigClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Java" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="JavaText" Margin="0,10,0,0" FontSize="12"
                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="120"
                        Click="OnSaveClick"/>
                <TextBlock x:Name="SaveHint" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource InkSoft}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
