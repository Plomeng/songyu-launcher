<UserControl x:Class="Songyu.App.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Margin="26,4,26,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,6,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="GameTab" Content="游戏版本" Tag="game" Style="{StaticResource TabButton}" Click="OnModeClick"/>
                <Button x:Name="ModTab" Content="Mod" Tag="mod" Style="{StaticResource TabButton}" Click="OnModeClick"/>
                <Button x:Name="PackTab" Content="整合包" Tag="pack" Style="{StaticResource TabButton}" Click="OnModeClick"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">

            <!-- ========== 游戏版本 ========== -->
            <Grid x:Name="GameRoot">
                <Grid x:Name="GameListView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="HintText" Margin="2,0,0,10" FontSize="12"
                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>

                    <ListBox Grid.Row="1" x:Name="VersionList"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnVersionSelected"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" Background="{StaticResource CardBg}" CornerRadius="10"
                                                    Padding="16,12" Margin="0,0,0,7" ClipToBounds="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Id}" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Note}" FontSize="11"
                                                                   Foreground="{StaticResource InkSoft}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="选择 ›" FontSize="12"
                                                               Foreground="{StaticResource InkSoft}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FFFDF6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

                <Grid x:Name="GameDetailView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="←" Style="{StaticResource GhostButton}" Width="40" Padding="0" Click="OnBackClick"/>
                        <TextBlock x:Name="DetailTitle" Margin="12,0,0,0" FontSize="19"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="选择加载器" Style="{StaticResource SectionLabel}"/>

                            <Button x:Name="VanillaCard" Tag="Vanilla" Style="{StaticResource SelectableCard}" Margin="0,0,0,7" Click="OnLoaderClick">
                                <StackPanel>
                                    <TextBlock Text="原版" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="不装任何加载器" FontSize="11" Foreground="{StaticResource InkSoft}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="FabricCard" Tag="Fabric" Style="{StaticResource SelectableCard}" Margin="0,0,0,7" Click="OnLoaderClick">
                                <StackPanel>
                                    <TextBlock Text="Fabric" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="轻量，Mod 生态活跃；自动取最新 stable 版本" FontSize="11" Foreground="{StaticResource InkSoft}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="QuiltCard" Tag="Quilt" Style="{StaticResource SelectableCard}" Margin="0,0,0,7" Click="OnLoaderClick">
                                <StackPanel>
                                    <TextBlock Text="Quilt" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Fabric 的分支，兼容大部分 Fabric Mod" FontSize="11" Foreground="{StaticResource InkSoft}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="ForgeCard" Tag="Forge" Style="{StaticResource SelectableCard}" Margin="0,0,0,7" Click="OnLoaderClick">
                                <StackPanel>
                                    <TextBlock Text="Forge" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="老牌加载器，整合包主流；自动运行官方安装器" FontSize="11" Foreground="{StaticResource InkSoft}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NeoForgeCard" Tag="NeoForge" Style="{StaticResource SelectableCard}" Margin="0,0,0,7" Click="OnLoaderClick">
                                <StackPanel>
                                    <TextBlock Text="NeoForge" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Forge 的分支，从 1.20.2 起支持" FontSize="11" Foreground="{StaticResource InkSoft}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="OptiFineCard" Tag="OptiFine" Style="{StaticResource SelectableCard}" Click="OnLoaderClick">
                                <StackPanel>
                                    <TextBlock Text="OptiFine" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="光影与性能优化；因授权限制，需从官网手动下载后导入" FontSize="11" Foreground="{StaticResource InkSoft}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock x:Name="DetailHint" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                        <Button x:Name="InstallButton" Content="开始安装" Style="{StaticResource PrimaryButton}"
                                Height="42" MinWidth="160" HorizontalAlignment="Right" Click="OnInstallClick"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ========== Mod ========== -->
            <Grid x:Name="ModRoot" Visibility="Collapsed">

                <!-- 搜索结果 -->
                <Grid x:Name="ModSearchView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="版本" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource InkSoft}"/>
                            <ComboBox x:Name="VersionCombo" Width="130" Margin="8,0,0,0"
                                      SelectionChanged="OnContextChanged"/>
                            <TextBlock Text="加载器" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource InkSoft}"/>
                            <ComboBox x:Name="LoaderCombo" Width="120" Margin="8,0,0,0"
                                      SelectionChanged="OnContextChanged"/>
                            <TextBlock x:Name="ModHint" Margin="14,0,0,0" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Grid Margin="0,12,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" KeyDown="OnSearchKeyDown" ToolTip="输入 Mod 名称，回车搜索"/>
                            <Button Grid.Column="1" Content="搜索" Style="{StaticResource SmallButton}"
                                    Margin="8,0,0,0" Click="OnSearchClick"/>
                        </Grid>
                    </StackPanel>

                    <ListBox Grid.Row="1" x:Name="ModList"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnModSelected"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" Background="{StaticResource CardBg}" CornerRadius="10"
                                                    Padding="14,11" Margin="0,0,0,7" ClipToBounds="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="44" Height="44" CornerRadius="8"
                                                            Background="#F2EEE2" ClipToBounds="True">
                                                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                                                                   Foreground="{StaticResource InkSoft}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding MetaText}" FontSize="11" Margin="0,2,0,0"
                                                                   Foreground="{StaticResource InkSoft}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#FFFDF6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

                <!-- 详情 -->
                <Grid x:Name="ModDetailView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="←" Style="{StaticResource GhostButton}" Width="40" Padding="0" Click="OnModBackClick"/>
                        <TextBlock x:Name="ModDetailTitle" Margin="12,0,0,0" FontSize="18"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="12"
                            Padding="16" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="56" Height="56" CornerRadius="10" Background="#F2EEE2" ClipToBounds="True">
                                <Image x:Name="ModIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock x:Name="ModDetailSubtitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ModDetailMeta" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ModDetailDesc" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="DependencySection" Grid.Row="2" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="前置依赖（必需，且尚未安装）" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                        <ItemsControl x:Name="ModDependencyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF6DF" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                <TextBlock Text="{Binding TypeText}" FontSize="10" Margin="0,2,0,0"
                                                           Foreground="{StaticResource InkSoft}"/>
                                            </StackPanel>
                                            <Button Content="打开页面" Tag="{Binding Url}"
                                                    Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="OnOpenUrlClick"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 版本列表自己滚动，只有一个滚动条；按「当前版本 / 其他版本」分组 -->
                    <ListBox Grid.Row="3" x:Name="ModVersionList" Margin="0,14,0,0"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Margin="2,10,0,8"
                                                   Foreground="{StaticResource InkSoft}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBg}" CornerRadius="10"
                                        Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionNumber}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding MetaText}" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource InkSoft}"/>
                                        </StackPanel>
                                        <Button Content="{Binding ActionText}" Tag="{Binding VersionId}"
                                                Style="{StaticResource SmallButton}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="OnInstallModVersionClick"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="ModInstallHint" Grid.Row="4" Margin="0,10,0,0" FontSize="12"
                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                </Grid>
            </Grid>

            <!-- ========== 整合包 ========== -->
            <Grid x:Name="PackRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导入整合包" Style="{StaticResource SmallButton}"
                                Height="34" Padding="16,0" Click="OnImportPackClick"/>
                        <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                                   Text="支持 .mrpack（Modrinth）与 .zip（CurseForge / 普通整合包）"/>
                    </StackPanel>
                    <TextBlock x:Name="PackHint" Margin="2,10,0,0" FontSize="12"
                               Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="PackList" Margin="0,12,0,0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBg}" CornerRadius="10"
                                    Padding="16,12" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="启动" Tag="{Binding VersionId}"
                                            Style="{StaticResource SmallButton}"
                                            VerticalAlignment="Center"
                                            Click="OnLaunchPackClick"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
