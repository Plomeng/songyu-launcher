<UserControl x:Class="Songyu.App.Pages.ScreenshotsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">

    <Grid Margin="26,20,26,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="截图" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,6,0,0"
                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PathText" FontSize="11" Margin="0,3,0,0"
                       Foreground="{StaticResource InkSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountText" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource InkSoft}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="刷新" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        Click="OnRefreshClick"/>
                <Button Content="打开目录" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        Margin="8,0,0,0" Click="OnOpenFolderClick"/>
            </StackPanel>
        </Grid>

        <!-- 网格 -->
        <Grid Grid.Row="2">
            <ListBox x:Name="ShotList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,12,12"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="{StaticResource CardBg}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="10" Padding="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush"
                                                    Value="{StaticResource EggYolk}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush"
                                                    Value="{StaticResource EggYolk}"/>
                                            <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="212">
                            <Border Background="#EDE7D8" CornerRadius="7" Height="120"
                                    ClipToBounds="True">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding CapturedText}" FontSize="11" Margin="2,8,0,0"
                                       Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="{Binding DetailText}" FontSize="10" Margin="2,3,0,2"
                                       Foreground="{StaticResource InkSoft}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开图片" Click="OnOpenShotClick"/>
                        <MenuItem Header="在文件夹中显示" Click="OnRevealShotClick"/>
                        <MenuItem Header="复制路径" Click="OnCopyPathClick"/>
                        <MenuItem Header="删除（进 .trash）" Click="OnDeleteShotClick"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" FontSize="15" HorizontalAlignment="Center"
                           Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="EmptySubtitle" FontSize="12" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource InkSoft}"
                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 底部说明 -->
        <TextBlock Grid.Row="3" FontSize="11" Margin="0,10,0,0"
                   Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                   Text="游戏里按 F2 截的图会存到这个目录。双击打开，右键可以删除或复制路径。"/>
    </Grid>
</UserControl>
