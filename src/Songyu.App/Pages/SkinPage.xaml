<UserControl x:Class="Songyu.App.Pages.SkinPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             FontFamily="{StaticResource AppFont}">

    <Grid Margin="26,20,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="皮肤" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,6,0,0"
                       Foreground="{StaticResource InkSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左：3D 预览（WebView2 承载 skinview3d） -->
            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid x:Name="PreviewHost" Background="#F5F1E9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <wv2:WebView2 x:Name="SkinView"/>

                    <!-- 角度控制 -->
                    <StackPanel x:Name="AnglePanel" Grid.Row="1" HorizontalAlignment="Center"
                                Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                        <Button Content="◀" Style="{StaticResource GhostButton}" Height="26" Width="34"
                                Padding="0" Click="OnRotateLeftClick"/>
                        <Button Content="▶" Style="{StaticResource GhostButton}" Height="26" Width="34"
                                Padding="0" Margin="6,0,0,0" Click="OnRotateRightClick"/>
                        <Button Content="⤢" Style="{StaticResource GhostButton}" Height="26" Width="34"
                                Padding="0" Margin="12,0,0,0" Click="OnZoomOutClick"
                                ToolTip="缩小"/>
                        <Button Content="⤡" Style="{StaticResource GhostButton}" Height="26" Width="34"
                                Padding="0" Margin="6,0,0,0" Click="OnZoomInClick"
                                ToolTip="放大"/>
                        <Button Content="重置" Style="{StaticResource GhostButton}" Height="26"
                                Padding="10,0" Margin="12,0,0,0" Click="OnResetViewClick"/>
                    </StackPanel>

                    <StackPanel x:Name="PreviewFallback" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock x:Name="FallbackTitle" FontSize="14" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="FallbackText" FontSize="11" Margin="0,8,0,0" MaxWidth="420"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource InkSoft}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：信息与操作 -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="SkinNameText" Text="未加载皮肤" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SkinMetaText" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="导入 PNG" Style="{StaticResource SmallButton}" Height="30"
                                    Click="OnImportClick"/>
                            <Button Content="用账号皮肤" Style="{StaticResource GhostButton}" Height="30"
                                    Padding="10,0" Margin="8,0,0,0" Click="OnUseAccountSkinClick"/>
                            <Button Content="保存到皮肤库" Style="{StaticResource GhostButton}" Height="30"
                                    Padding="10,0" Margin="8,0,0,0" Click="OnSaveClick"/>
                            <Button x:Name="SelectOfflineSkinButton" Content="设为首页预览皮肤"
                                    Style="{StaticResource GhostButton}" Height="30"
                                    Padding="10,0" Margin="8,0,0,0" Click="OnSelectOfflineSkinClick"
                                    ToolTip="只改变启动器内的皮肤预览，不改变游戏内皮肤"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="ModelButton" Content="模型：classic" Style="{StaticResource GhostButton}" Height="30"
                                    Padding="10,0" Click="OnToggleModelClick"/>
                            <Button Content="暂停动画" Style="{StaticResource GhostButton}" Height="30"
                                    Padding="10,0" Margin="8,0,0,0" Click="OnToggleAnimationClick"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="皮肤库" FontSize="12" FontWeight="SemiBold"/>
                        <ListBox x:Name="LibraryList" Margin="0,10,0,0" MaxHeight="220"
                                 Background="Transparent" BorderThickness="0"
                                 SelectionChanged="OnLibrarySelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="LibraryEmpty" Text="还没有保存过皮肤" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{StaticResource InkSoft}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <TextBlock FontSize="11" Margin="4,14,0,0"
                           Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                           Text="上传到正版账号需要正版登录且服务允许。当前只做本地预览与保存。"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
