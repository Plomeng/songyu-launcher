<UserControl x:Class="Songyu.App.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="26,20,26,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题：实例由首页选中的那个决定，这里不再提供切换 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Mod 管理" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,6,0,0"
                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PathText" FontSize="11" Margin="0,3,0,0"
                       Foreground="{StaticResource InkSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountText" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource InkSoft}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Margin="0,0,8,0">
                    <TextBox x:Name="SearchBox" Width="190" Height="32"
                             TextChanged="OnSearchTextChanged"
                             ToolTip="按 Mod 名字 / 文件名 / modid 过滤"/>
                    <TextBlock x:Name="SearchHint" Text="搜索名字或 modid" FontSize="12"
                               Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource InkSoft}" IsHitTestVisible="False"/>
                </Grid>
                <Button Content="检查更新" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        ToolTip="按 sha1 去 Modrinth 查有没有适配当前加载器/MC 版本的新版本"
                        Click="OnCheckUpdatesClick"/>
                <Button Content="诊断冲突" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        Margin="8,0,0,0"
                        ToolTip="检查依赖缺失、重复安装、声明不兼容"
                        Click="OnDiagnoseClick"/>
                <Button Content="识别来源" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        Margin="8,0,0,0"
                        ToolTip="按 sha1 去 Modrinth 反查这些文件属于哪个项目/版本"
                        Click="OnIdentifyClick"/>
                <Button Content="刷新" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        Margin="8,0,0,0" Click="OnRefreshClick"/>
                <Button Content="导入 jar" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        Margin="8,0,0,0" Click="OnImportClick"/>
                <Button Content="打开目录" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        Margin="8,0,0,0" Click="OnOpenDirectoryClick"/>
            </StackPanel>
        </Grid>

        <!-- 筛选标签 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="FilterAll" Tag="All" Content="全部" Style="{StaticResource TabButton}"
                    Click="OnFilterClick"/>
            <Button x:Name="FilterUpdate" Tag="HasUpdate" Content="有更新" Style="{StaticResource TabButton}"
                    Click="OnFilterClick"/>
            <Button x:Name="FilterLocal" Tag="LocalSource" Content="本地来源" Style="{StaticResource TabButton}"
                    Click="OnFilterClick"/>
            <Button x:Name="FilterDisabled" Tag="Disabled" Content="已禁用" Style="{StaticResource TabButton}"
                    Click="OnFilterClick"/>
        </StackPanel>

        <!-- 列表 -->
        <Grid Grid.Row="3">
            <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="NameText" Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Version}" FontSize="11"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource InkSoft}"/>
                                        <Border Background="#FFF3D6" BorderBrush="{StaticResource EggYolk}"
                                                BorderThickness="1" CornerRadius="6" Padding="6,1"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding UpdateText}" FontSize="10"
                                                       Foreground="#8A5A12"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DetailLine}" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{StaticResource InkSoft}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="更新" Style="{StaticResource SmallButton}"
                                            Height="28" MinWidth="56" Margin="0,0,8,0"
                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"
                                            Tag="{Binding}" Click="OnUpdateClick"/>
                                    <Button Content="{Binding ToggleLabel}" Style="{StaticResource GhostButton}"
                                            Height="28" MinWidth="64"
                                            Tag="{Binding}" Click="OnToggleClick"/>
                                    <Button Content="删除" Style="{StaticResource GhostButton}"
                                            Height="28" MinWidth="56" Margin="8,0,0,0"
                                            Tag="{Binding}" Click="OnDeleteClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- 已禁用的整体压暗，一眼能分辨 -->
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="Card" Property="Background" Value="#F7F4EC"/>
                                <Setter TargetName="NameText" Property="Foreground"
                                        Value="{StaticResource InkSoft}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Text="这个实例还没有 Mod" FontSize="15"
                           Foreground="{StaticResource InkSoft}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptySubtitle" Text="可以去「下载」页面装，或者点右上角「导入 jar」"
                           FontSize="12" Foreground="{StaticResource InkSoft}"
                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="LoadingText" Text="正在读取 Mod 信息…" FontSize="13"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{StaticResource InkSoft}" Visibility="Collapsed"/>
        </Grid>

        <!-- 底部说明 -->
        <TextBlock x:Name="FooterText" Grid.Row="4" FontSize="11" Margin="0,10,0,0"
                   Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                   Text="禁用是把文件改名成 .jar.disabled，删除会挪进 mods\.trash —— 都不会真删。"/>
    </Grid>
</UserControl>
