<UserControl x:Class="Songyu.App.Pages.ServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">

    <Grid Margin="26,20,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="联机" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,6,0,0"
                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PathText" FontSize="11" Margin="0,3,0,0"
                       Foreground="{StaticResource InkSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CountText" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource InkSoft}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="添加服务器" Style="{StaticResource SmallButton}" Height="32"
                        Click="OnAddClick"/>
                <Button Content="刷新" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        Margin="8,0,0,0" Click="OnRefreshClick"/>
                <Button Content="打开目录" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                        Margin="8,0,0,0" Click="OnOpenFolderClick"/>
            </StackPanel>
        </Grid>

        <!-- 列表 -->
        <Grid Grid.Row="2">
            <ListBox x:Name="ServerList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="{StaticResource CardBg}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="10" Padding="16,12">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush"
                                                    Value="{StaticResource EggYolk}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush"
                                                    Value="{StaticResource EggYolk}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Address}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource InkSoft}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="进入" Style="{StaticResource SmallButton}"
                                        Height="28" MinWidth="56" Tag="{Binding}" Click="OnJoinClick"/>
                                <Button Content="复制地址" Style="{StaticResource GhostButton}"
                                        Height="28" Padding="10,0" Margin="8,0,0,0"
                                        Tag="{Binding}" Click="OnCopyClick"/>
                                <Button Content="删除" Style="{StaticResource GhostButton}"
                                        Height="28" Padding="10,0" Margin="8,0,0,0"
                                        Tag="{Binding}" Click="OnDeleteClick"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="进入服务器" Click="OnJoinClick"/>
                        <MenuItem Header="复制地址" Click="OnCopyClick"/>
                        <MenuItem Header="删除" Click="OnDeleteClick"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- 空状态 -->
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" FontSize="15" HorizontalAlignment="Center"
                           Foreground="{StaticResource Ink}"/>
                <TextBlock x:Name="EmptySubtitle" FontSize="12" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource InkSoft}"
                           TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
